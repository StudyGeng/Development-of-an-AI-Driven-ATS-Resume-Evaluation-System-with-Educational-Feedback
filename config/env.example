# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3307
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_DATABASE=career_navigator
# MYSQL_SSL_CA=
# PORT=5000
# Use development only on your own computer. Hosted deployments must use production.
# APP_ENV=development
# FLASK_DEBUG=0
# Required in production and must contain at least 32 characters.
# Generate a unique value with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Store the real production value only in the hosting provider's secret/environment settings.
# Never commit the real value to GitHub. "replace_me" is intentionally invalid.
# FLASK_SECRET_KEY=replace_me
# There is no default administrator. ADMIN_EMAILS is required in production.
# Set real addresses only in private environment settings.
# Use a comma-separated list for multiple administrators.
# ADMIN_EMAILS=replace_with_your_real_admin_email

# Production must use a working Resend or SMTP provider and keep this disabled.
# Development PIN exposure requires APP_ENV=development and this explicit opt-in.
# EMAIL_PIN_DEV_MODE=0

# PIN expiry, per-PIN attempt limit, and request/attempt rate limits.
# Keep conservative values in production.
# EMAIL_PIN_TTL_MINUTES=10
# EMAIL_PIN_MAX_ATTEMPTS=5
# EMAIL_PIN_REQUEST_LIMIT_PER_EMAIL=3
# EMAIL_PIN_REQUEST_LIMIT_PER_IP=10
# EMAIL_PIN_REQUEST_WINDOW_MINUTES=15
# EMAIL_PIN_ATTEMPT_LIMIT_PER_IP=20
# EMAIL_PIN_RATE_WINDOW_MINUTES=15

# Do not trust forwarded client-IP headers by default.
# Set this only to the exact number of trusted reverse-proxy hops in front of Flask.
# An incorrect value can weaken source-IP rate limiting.
# TRUSTED_PROXY_COUNT=0

# Hosted email OTP setup with Resend HTTP API
# This works on hosting providers that block SMTP ports.
# Both values are required when using Resend.
# RESEND_API_KEY=your_resend_api_key
# RESEND_FROM=UTS CS Career Navigator <no-reply@your-verified-domain.example>

# Email OTP setup with Resend SMTP
# Resend's test sender can usually send only to your own Resend account email.
# For other users, verify a domain in Resend and use a From email from that domain.
# SMTP_HOST and SMTP_FROM are required. Username and password must be set together.
# Production requires SMTP_USE_TLS=1.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=your_resend_api_key
# SMTP_FROM=UTS CS Career Navigator <no-reply@your-verified-domain.example>
# SMTP_USE_TLS=1

# Gmail SMTP alternative for free FYP testing
# Requires Google 2-Step Verification and a Gmail App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=yourgmail@gmail.com
# SMTP_PASSWORD=your_gmail_app_password
# SMTP_FROM=yourgmail@gmail.com
# SMTP_USE_TLS=1
